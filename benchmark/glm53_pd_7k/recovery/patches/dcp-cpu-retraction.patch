+def maybe_dcp_kernel_indices(
+    indices: torch.Tensor, dcp_size: int, dcp_rank: int
+) -> torch.Tensor:
+    """Map page-aligned logical runs to the owning rank's physical MLA rows.
+
+    Backport of upstream #39487. Allocator pages are widened by dcp_size;
+    a run can contain reordered pages and a ragged final page.
+    """
+    if dcp_size == 1:
+        return indices
+    return indices[dcp_rank::dcp_size] // dcp_size
+
